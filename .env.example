# Runtime
NODE_ENV=development
PORT=3000
PUBLIC_API_URL=http://localhost:3000/api/v1
CORS_ORIGINS=http://localhost:3000,http://localhost:3100

# PostgreSQL: pooler untuk aplikasi, koneksi langsung hanya untuk migrasi manual
DATABASE_URL=postgresql://USER:PASSWORD@POOLER_HOST/DATABASE?sslmode=require
DIRECT_URL=postgresql://USER:PASSWORD@DIRECT_HOST/DATABASE?sslmode=require

# Cache dan pencarian
REDIS_URL=rediss://USER:PASSWORD@REDIS_HOST:PORT
QDRANT_URL=https://YOUR_CLUSTER.cloud.qdrant.io
QDRANT_API_KEY=

# Authentication dan OTP
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d
OTP_SECRET=replace-with-a-separate-random-secret
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=KOMIT <noreply@example.com>

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# AI
GOOGLE_API_KEY=
OPENAI_API_KEY=

# Midtrans Sandbox
MIDTRANS_SERVER_KEY=SB-Mid-server-REPLACE_ME
MIDTRANS_CLIENT_KEY=SB-Mid-client-REPLACE_ME
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_EXPIRY_MINUTES=15

# Optional legacy integrations
QRIS_MERCHANT_ID=
QRIS_API_KEY=
SENTRY_DSN=
