datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  SUPER_ADMIN
  ADMIN_KOPDES
  PEGAWAI_KOPDES
  CUSTOMER
  UMKM
  COURIER
}

enum OrderStatus {
  PENDING
  PAID
  PROCESSING
  READY_FOR_DELIVERY
  OUT_FOR_DELIVERY
  DELIVERED
  COMPLETED
  CANCELLED
}

/// Metode pembayaran.
///
/// COD dan QRIS sudah ada sejak awal; QRIS kini ditangani Midtrans Core API,
/// bukan kode tiruan. Sisanya metode Midtrans yang aktif di akun merchant —
/// yang belum aktif sengaja tidak didaftarkan di sini supaya tidak ada
/// pilihan yang pasti gagal saat ditekan.
/// Satuan jual.
///
/// Enum, bukan teks bebas: `unit` sebelumnya `String` dengan bawaan "pcs",
/// dan dua Kopdes menulis "kg", "Kg", dan "kilogram" untuk barang yang sama —
/// membuat ringkasan stok lintas desa tidak bisa dijumlahkan.
enum ProductUnit {
  PCS
  PACK
  BOX
  DUS
  SACHET
  BOTOL
  KALENG
  RENTENG
  LUSIN
  IKAT
  KARUNG
  GRAM
  KILOGRAM
  MILILITER
  LITER
}

/// Cara pembeli menerima barangnya.
///
/// Dipisah dari [PaymentMethod] karena keduanya memang dua keputusan: COD
/// hanya masuk akal bersama pengantaran, sementara pembayaran di muka berlaku
/// untuk keduanya. Gabungannya divalidasi di service, bukan diringkas jadi
/// satu enum berisi tiga pilihan — kalau digabung, menambah satu metode bayar
/// berarti menambah dua nilai enum lagi.
enum FulfillmentMethod {
  /// Barang disiapkan, pembeli mengambil sendiri di Kopdes.
  PICKUP

  /// Diantar kurir desa ke alamat pembeli.
  DELIVERY
}

/// Varian jual sebuah produk — opsional.
///
/// Produk tanpa varian tetap sah: harga, stok, dan satuannya ada di
/// [Product] itu sendiri. Varian dipakai ketika satu barang punya beberapa
/// kemasan atau ukuran yang harganya berbeda, mis. kopi 250 g dan 1 kg.
///
/// [price], [stock], dan [unit] boleh null dan berarti "ikut produk induknya".
/// Menyalin nilai induk ke tiap varian membuat perubahan harga harus ditulis
/// di banyak baris, dan satu yang terlewat menjual barang dengan harga lama.
model ProductVariant {
  id        String  @id @default(uuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  /// Nama yang dibaca pembeli, mis. "250 g", "1 kg", "Merah".
  name String

  /// Kode internal Kopdes untuk varian ini. Unik per produk, bukan global.
  sku String?

  price Decimal?     @db.Decimal(12, 2)
  stock Int?
  unit  ProductUnit?

  /// Foto khusus varian ini. Null berarti memakai foto produknya.
  imageUrl String?

  isActive Boolean @default(true)

  /// Urutan tampil yang ditentukan pengurus; tanpa ini urutannya mengikuti
  /// id acak dan berubah tiap permintaan.
  sortOrder Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cartItems  CartItem[]
  orderItems OrderItem[]

  @@unique([productId, name])
  @@unique([productId, sku])
  @@index([productId, isActive])
}

enum PaymentMethod {
  COD
  /// Dibayar dari saldo dompet KOMIT saat pesanan dibuat.
  WALLET
  /// Pemilihan kanal pembayaran dilakukan di popup Midtrans Snap.
  MIDTRANS
  QRIS
  GOPAY
  SHOPEEPAY
  BCA_VA
  BNI_VA
  BRI_VA
  PERMATA_VA
  MANDIRI_BILL
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum DeliveryStatus {
  ASSIGNED
  ACCEPTED
  PICKED_UP
  IN_TRANSIT
  COURIER_DELIVERED
  CUSTOMER_CONFIRMED
  COMPLETED
}

enum UMKMStatus {
  PENDING_VERIFICATION
  ACTIVE
  REJECTED
  SUSPENDED
}

/// Pengelompokan kategori untuk dua baris filter di Marketplace.
///
/// Tanpa ini, "Filter Makanan" dan "Filter Barang Ritel" hanya bisa ditebak
/// dari nama kategori — dan tebakan itu akan meleset begitu pengurus menambah
/// kategori baru.
enum CategoryGroup {
  FOOD
  RETAIL
}

/// Kategori usaha Mitra UMKM. Dipakai sebagai filter di beranda customer.
enum UMKMCategory {
  KULINER
  SWALAYAN
  MINUMAN
  KERAJINAN
  JASA
  LAINNYA
}

/// Pengajuan koperasi desa untuk bergabung ke sistem.
enum KopdesApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

/// Jenis mutasi saldo. Menentukan tanda nominalnya, bukan menggantikannya:
/// `amount` tetap ditulis bertanda, sehingga penjumlahan seluruh entri selalu
/// sama dengan saldo tanpa perlu tahu artinya tiap jenis.
enum WalletEntryType {
  /// Isi ulang yang sudah lunas di Midtrans.
  TOPUP
  /// Pembayaran pesanan memakai saldo.
  PAYMENT
  /// Pengembalian dana pesanan yang batal.
  REFUND
  /// Koreksi manual oleh Super Admin. Selalu meninggalkan alasan.
  ADJUSTMENT
}

/// Status pengisian saldo, mengikuti siklus transaksi Midtrans.
enum TopUpStatus {
  PENDING
  PAID
  EXPIRED
  FAILED
}

/// Status keanggotaan warga pada sebuah Kopdes.
///
/// Alurnya sama dengan verifikasi Mitra UMKM: warga mengajukan, Admin Kopdes
/// yang memutuskan. Tidak ada jalur "langsung aktif" — keanggotaan koperasi
/// menentukan siapa yang berhak atas layanan anggota, jadi harus diverifikasi
/// manusia, bukan diberikan oleh formulir.
enum MembershipStatus {
  PENDING
  ACTIVE
  REJECTED
}

enum InventoryTransactionType {
  IN
  OUT
  ADJUSTMENT
}

/// Koperasi Desa Merah Putih.
///
/// Dibuat multi-baris sejak awal supaya SUPER_ADMIN tinggal menambah record
/// untuk desa lain tanpa perlu refactor skema lagi. Saat ini hanya ada satu
/// baris; `Product.kopdesId` dan `UMKM.kopdesId` sengaja masih nullable agar
/// data lama tetap valid, dan bisa dijadikan wajib lewat migration terpisah
/// setelah alur pembuatan Kopdes oleh super admin berjalan.
model Koperasi {
  id          String  @id @default(uuid())
  name        String
  description String?
  logoUrl     String?
  imageUrl    String?

  // Alamat administratif
  address    String
  village    String // desa
  district   String // kecamatan
  city       String // kabupaten/kota
  province   String
  postalCode String?

  /// Koordinat dipakai untuk pencarian terdekat. Wajib — tanpa ini record
  /// tidak akan pernah muncul di hasil /koperasi/nearby.
  latitude  Float
  longitude Float

  phone String?

  /// Jam operasional per hari, mis.
  /// { "mon": { "open": "07:00", "close": "17:00" }, "sun": null }
  operatingHours Json?

  /// Kategori layanan yang ditampilkan di card, mis. ["Sembako", "Pangan"].
  serviceCategories String[] @default([])

  isActive   Boolean @default(true)
  isVerified Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]
  umkms    UMKM[]
  reviews  Review[]
  staff    User[]             @relation("KopdesStaff")
  members  KopdesMembership[]

  /// Pengajuan yang melahirkan koperasi ini, bila ia masuk lewat formulir.
  application KopdesApplication?

  /// Filter kasar bounding-box memakai index ini sebelum jarak Haversine
  /// dihitung pada sisa baris.
  @@index([latitude, longitude])
  @@index([isActive])
}

model User {
  id        String  @id @default(uuid())
  email     String  @unique
  password  String
  name      String
  phone     String?
  /// Foto akun untuk seluruh peran. Berbeda dari logo/foto toko.
  avatarUrl String?
  role      Role    @default(CUSTOMER)

  /// Kopdes tempat staf (ADMIN_KOPDES / PEGAWAI_KOPDES) ditugaskan.
  /// Seluruh query operasional staf disaring dengan kolom ini — tanpa itu
  /// seorang pegawai bisa membaca pesanan desa lain. Nullable karena
  /// CUSTOMER, UMKM, COURIER, dan SUPER_ADMIN tidak terikat satu desa.
  kopdesId String?
  kopdes   Koperasi? @relation("KopdesStaff", fields: [kopdesId], references: [id])

  /// Penyempitan permission per pengguna. Kosong = pakai bawaan role
  /// (lihat src/common/permissions.ts). Terisi = hanya yang tercantum,
  /// dan tetap dipotong oleh bawaan role sehingga tidak bisa menaikkan
  /// wewenang melewati batas rolenya.
  permissions String[] @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  addresses             Address[]
  cart                  Cart?
  umkm                  UMKM?
  orders                Order[]                      @relation("CustomerOrders")
  deliveries            Delivery[]                   @relation("CourierDeliveries")
  reviews               Review[]
  suggestions           CommunitySuggestion[]
  notifications         Notification[]
  auditLogs             AuditLog[]
  inventoryTransactions InventoryTransaction[]
  refreshTokens         RefreshToken[]
  suggestionSupports    CommunitySuggestionSupport[]
  conversationsAsA      Conversation[]               @relation("ConvUser1")
  conversationsAsB      Conversation[]               @relation("ConvUser2")
  chatMessages          ChatMessage[]
  memberships           KopdesMembership[]
  wallet                Wallet?

  @@index([kopdesId])
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Pendaftaran pelanggan yang belum menyelesaikan verifikasi email.
/// Kode OTP tidak pernah disimpan mentah; hanya HMAC-nya yang tinggal di DB.
model CustomerEmailVerification {
  id              String   @id @default(uuid())
  email           String   @unique
  passwordHash    String
  name            String
  phone           String?
  codeHash        String
  expiresAt       DateTime
  resendAllowedAt DateTime
  attempts        Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([expiresAt])
}

model Address {
  id            String  @id @default(uuid())
  userId        String
  user          User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  title         String
  recipientName String
  phone         String
  street        String
  city          String
  state         String
  postalCode    String
  isDefault     Boolean @default(false)

  /// Titik rumah, diisi pembeli lewat "Gunakan lokasi saya".
  ///
  /// Null untuk alamat lama dan untuk pembeli yang menolak izin lokasi —
  /// kurir masih bisa mengantar dengan teks alamatnya, hanya tanpa peta.
  /// Jangan ganti dengan 0,0: koordinat itu nyata, di Teluk Guinea.
  latitude  Float?
  longitude Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders Order[]
}

model Category {
  id          String  @id @default(uuid())
  name        String  @unique
  description String?

  /// Menentukan baris filter mana yang menampilkan kategori ini di
  /// Marketplace. RETAIL sebagai default: kategori baru muncul di barang
  /// ritel sampai pengurus memindahkannya — bukan hilang dari kedua baris.
  group CategoryGroup @default(RETAIL)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products     Product[]
  umkmProducts UMKMProduct[]

  @@index([group])
}

model Product {
  id          String    @id @default(uuid())
  name        String
  description String
  price       Decimal   @db.Decimal(12, 2)
  stock       Int
  categoryId  String
  category    Category  @relation(fields: [categoryId], references: [id])
  kopdesId    String?
  kopdes      Koperasi? @relation(fields: [kopdesId], references: [id])
  isActive    Boolean   @default(true)

  /// Harga coret. Null = tidak sedang diskon. Decimal, bukan Float:
  /// nominal rupiah tidak boleh kehilangan presisi.
  discountPrice Decimal? @db.Decimal(12, 2)

  /// Satuan jual yang tampil di samping harga.
  unit ProductUnit @default(PCS)

  /// Kode internal Kopdes. Unik per Kopdes, bukan global — dua desa boleh
  /// memakai kode yang sama untuk barang mereka masing-masing.
  sku String?

  /// Ambang "stok menipis". KPI dashboard memakai kolom ini, bukan angka
  /// ajaib di kode: tiap barang punya titik pesan ulang yang berbeda.
  minStock Int @default(5)

  /// Ditandai admin sebagai produk pilihan untuk beranda.
  isFeatured Boolean @default(false)

  isPreOrderAllowed   Boolean   @default(false)
  preOrderAvailableAt DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  images                ProductImage[]
  variants              ProductVariant[]
  reviews               Review[]
  cartItems             CartItem[]
  orderItems            OrderItem[]
  inventoryTransactions InventoryTransaction[]

  @@unique([kopdesId, sku])
  @@index([kopdesId])
  @@index([isFeatured])
}

model ProductImage {
  id            String       @id @default(uuid())
  productId     String?
  product       Product?     @relation(fields: [productId], references: [id], onDelete: Cascade)
  umkmProductId String?
  umkmProduct   UMKMProduct? @relation(fields: [umkmProductId], references: [id], onDelete: Cascade)
  url           String
  isPrimary     Boolean      @default(false)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}

model Cart {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items CartItem[]
}

model CartItem {
  id            String       @id @default(uuid())
  cartId        String
  cart          Cart         @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId     String?
  product       Product?     @relation(fields: [productId], references: [id])
  umkmProductId String?
  umkmProduct   UMKMProduct? @relation(fields: [umkmProductId], references: [id])

  /// Varian yang dipilih. Null pada produk tanpa varian.
  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id])

  quantity  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Kunci unik memuat varian: dua kemasan berbeda dari produk yang sama
  /// adalah dua baris keranjang, bukan satu baris yang jumlahnya bertambah.
  @@unique([cartId, productId, variantId])
  @@unique([cartId, umkmProductId])
}

model Order {
  id         String @id @default(uuid())
  customerId String
  customer   User   @relation("CustomerOrders", fields: [customerId], references: [id])

  /// Nilai barang sebelum ongkir dan diskon.
  ///
  /// Disimpan terpisah, bukan disimpulkan dari `totalAmount`: begitu ongkir
  /// atau diskon ikut dihitung, tidak ada cara memulihkan nilai barang dari
  /// satu angka total — dan rekap keuangan koperasi butuh ketiganya.
  subtotal Decimal @default(0) @db.Decimal(12, 2)

  /// Ongkir yang dibebankan ke pemesan. Nol untuk pickup.
  shippingFee Decimal @default(0) @db.Decimal(12, 2)

  /// Potongan promo/voucher yang berlaku pada pesanan ini.
  discountAmount Decimal @default(0) @db.Decimal(12, 2)

  /// subtotal + shippingFee - discountAmount. Tetap disimpan agar nominal
  /// yang ditagihkan tidak pernah berubah kalau rumusnya direvisi nanti.
  totalAmount   Decimal       @db.Decimal(12, 2)
  status        OrderStatus   @default(PENDING)
  paymentMethod PaymentMethod
  paymentStatus PaymentStatus @default(PENDING)

  /// Cara pembeli menerima barangnya.
  ///
  /// Gabungannya dengan [paymentMethod] menghasilkan tiga pilihan yang
  /// ditawarkan di aplikasi: bayar di muka + ambil sendiri, COD + diantar,
  /// dan bayar di muka + diantar. COD + ambil sendiri ditolak service:
  /// membayar di tempat saat mengambil sendiri sama saja dengan transaksi
  /// kasir, yang punya alurnya sendiri.
  fulfillment       FulfillmentMethod @default(DELIVERY)
  deliveryAddressId String
  deliveryAddress   Address           @relation(fields: [deliveryAddressId], references: [id])

  /// Pengajuan pembatalan oleh pemesan.
  ///
  /// Pembatalan bukan tombol sepihak: pemesan mengajukan, pemilik barang
  /// yang memutuskan. Keadaannya dibaca dari ketiga kolom ini, bukan dari
  /// enum tersendiri — diajukan bila `cancelRequestedAt` terisi dan
  /// `cancelDecidedAt` masih kosong; disetujui bila sudah diputus dan
  /// statusnya CANCELLED; ditolak bila sudah diputus tetapi tidak.
  cancelRequestedAt  DateTime?
  cancelReason       String?
  cancelDecidedAt    DateTime?
  cancelDecidedById  String?
  cancelRejectReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items    OrderItem[]
  payment  Payment?
  invoice  Invoice?
  delivery Delivery?

  @@index([cancelRequestedAt, cancelDecidedAt])
}

model OrderItem {
  id            String       @id @default(uuid())
  orderId       String
  order         Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId     String?
  product       Product?     @relation(fields: [productId], references: [id])
  umkmProductId String?
  umkmProduct   UMKMProduct? @relation(fields: [umkmProductId], references: [id])

  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id])

  /// Nama varian saat dipesan, dibekukan di sini.
  ///
  /// Varian bisa diubah namanya atau dinonaktifkan setelah pesanan dibuat;
  /// invoice lama harus tetap menyebut apa yang benar-benar dibeli.
  variantName String?

  quantity  Int
  price     Decimal  @db.Decimal(12, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Invoice {
  id            String   @id @default(uuid())
  orderId       String   @unique
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  invoiceNumber String   @unique
  pdfUrl        String?
  issuedAt      DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

/// Pembayaran satu pesanan.
///
/// Satu baris per pesanan (`orderId` unik). Kolom Midtrans ditambahkan di
/// sini alih-alih di tabel baru: pesanan hanya punya satu pembayaran, dan
/// tabel kedua akan menduplikasi status yang harus selalu sama.
model Payment {
  id            String        @id @default(uuid())
  orderId       String        @unique
  order         Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  method        PaymentMethod
  status        PaymentStatus @default(PENDING)
  amount        Decimal       @db.Decimal(12, 2)
  transactionId String?       @unique
  qrisCode      String?
  paidAt        DateTime?

  // ── Midtrans ──
  /// `order_id` yang dikirim ke Midtrans: KOMIT-{orderId}-{timestamp}.
  /// Unik dan tidak sama dengan id pesanan kita — Midtrans menolak order_id
  /// yang dipakai ulang, sementara pesanan yang kedaluwarsa boleh dibayar
  /// ulang dengan transaksi baru.
  midtransOrderId String? @unique

  /// Sesi Snap yang dibuka klien. Token aman dipublikasikan ke pemilik
  /// pesanan; Server Key tetap hanya berada di backend.
  snapToken       String? @unique
  snapRedirectUrl String?

  /// `payment_type` mentah dari Midtrans (qris, gopay, bank_transfer, …).
  /// Disimpan apa adanya supaya bentuk respons yang berbeda per metode tetap
  /// bisa ditelusuri tanpa menebak dari `method`.
  midtransPaymentType String?

  /// Bank penerbit VA, dan nomornya. Hanya terisi untuk bank_transfer.
  bank     String?
  vaNumber String?

  /// Tautan yang diberikan Midtrans. Tidak pernah dibuat sendiri — QR yang
  /// digambar aplikasi bukan QR yang diakui penerbitnya.
  qrCodeUrl   String?
  deeplinkUrl String?

  /// Status mentah Midtrans beserta penilaian fraud-nya. Dipisah dari
  /// `status` internal supaya pemetaannya bisa diperiksa ulang.
  transactionStatus String?
  fraudStatus       String?

  expiryTime DateTime?

  /// Respons charge terakhir, untuk penelusuran. Tidak memuat rahasia:
  /// Midtrans tidak mengembalikan kunci apa pun pada respons charge.
  rawResponse Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  webhookEvents PaymentWebhookEvent[]

  @@index([status])
  @@index([expiryTime])
}

/// Notifikasi webhook Midtrans yang sudah diproses.
///
/// Ada dua alasan menyimpannya: idempotensi — Midtrans mengirim ulang
/// notifikasi yang sama sampai dijawab 200, dan satu notifikasi tidak boleh
/// mengubah pesanan dua kali; dan jejak audit ketika status pesanan
/// dipertanyakan kemudian.
model PaymentWebhookEvent {
  id        String   @id @default(uuid())
  paymentId String?
  payment   Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  /// `order_id` dari notifikasi; bukan id pesanan kita.
  midtransOrderId String

  /// `transaction_id` Midtrans. Bersama statusnya membentuk kunci unik:
  /// satu transaksi bisa sah mengirim beberapa status berbeda (pending lalu
  /// settlement), tetapi status yang sama tidak boleh diproses dua kali.
  transactionId     String
  transactionStatus String
  fraudStatus       String?
  statusCode        String
  grossAmount       String

  /// Payload utuh. Tidak memuat rahasia — `signature_key` di dalamnya adalah
  /// hasil hash, bukan kunci server.
  payload Json

  /// Diisi bila notifikasi ditolak, beserta alasannya.
  rejectedReason String?

  createdAt DateTime @default(now())

  @@unique([transactionId, transactionStatus])
  @@index([midtransOrderId])
  @@index([createdAt])
}

model Delivery {
  id        String         @id @default(uuid())
  orderId   String         @unique
  order     Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  courierId String?
  courier   User?          @relation("CourierDeliveries", fields: [courierId], references: [id])
  status    DeliveryStatus @default(ASSIGNED)

  /// Saat kurir mengambil tugas ini — lewat "Ambil Tugas" atau menerima
  /// penugasan pengurus. Null selama pengantaran masih di kumpulan terbuka.
  acceptedAt DateTime?

  /// Saat barang benar-benar keluar toko. Inilah yang memindahkan pesanan
  /// ke OUT_FOR_DELIVERY, bukan penugasan kurirnya.
  pickedUpAt DateTime?

  /// Posisi kurir saat menekan "Barang Sudah Diantar" — sisi kurir dari
  /// dual-validation. Null bila GPS mati saat itu.
  deliveredLatitude  Float?
  deliveredLongitude Float?

  courierMarkedDeliveredAt DateTime?
  customerConfirmedAt      DateTime?
  estimatedDeliveryTime    DateTime?
  actualDeliveryTime       DateTime?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  locations DeliveryLocation[]

  @@index([courierId, status])
}

model DeliveryLocation {
  id         String   @id @default(uuid())
  deliveryId String
  delivery   Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  latitude   Float
  longitude  Float
  recordedAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model UMKM {
  id              String     @id @default(uuid())
  userId          String     @unique
  user            User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessName    String
  description     String
  address         String
  phone           String
  status          UMKMStatus @default(PENDING_VERIFICATION)
  rejectionReason String?
  verifiedAt      DateTime?

  /// Nullable: 3 UMKM yang sudah ada terdaftar sebelum koordinat diminta.
  /// UMKM tanpa koordinat tidak muncul di hasil pencarian terdekat.
  latitude  Float?
  longitude Float?

  category       UMKMCategory @default(LAINNYA)
  photoUrl       String?
  /// Sampul lebar halaman toko. `photoUrl` tetap menjadi logo/foto toko.
  bannerUrl      String?
  /// Bentuk sama dengan Koperasi.operatingHours.
  operatingHours Json?

  /// Kopdes tempat UMKM ini bermitra (1 desa = 1 Kopdes).
  kopdesId String?
  kopdes   Koperasi? @relation(fields: [kopdesId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products UMKMProduct[]
  reviews  Review[]

  bankAccount UMKMBankAccount?
  payouts     UMKMPayout[]

  @@index([latitude, longitude])
  @@index([category])
  @@index([kopdesId])
}

model UMKMProduct {
  id              String   @id @default(uuid())
  umkmId          String
  umkm            UMKM     @relation(fields: [umkmId], references: [id], onDelete: Cascade)
  name            String
  description     String
  price           Decimal  @db.Decimal(12, 2)
  stock           Int
  categoryId      String
  category        Category @relation(fields: [categoryId], references: [id])
  isApproved      Boolean  @default(false)
  rejectionReason String?
  isActive        Boolean  @default(true)

  /// Ditandai admin sebagai "Produk UMKM Pilihan" di beranda.
  isFeatured          Boolean   @default(false)
  isPreOrderAllowed   Boolean   @default(false)
  preOrderAvailableAt DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  images                ProductImage[]
  cartItems             CartItem[]
  orderItems            OrderItem[]
  reviews               Review[]
  inventoryTransactions InventoryTransaction[]

  @@index([isFeatured])
}

/// Ulasan pengguna.
///
/// Satu baris menunjuk tepat satu sasaran: produk koperasi, produk UMKM,
/// Kopdes, atau Mitra UMKM. Rating pada card Kopdes/UMKM dihitung dari
/// agregasi baris-baris ini — tidak ada kolom rating yang ditulis manual,
/// sehingga angkanya selalu berasal dari ulasan nyata.
/// Halaman informasi yang isinya dikelola dari backend.
///
/// Dipakai untuk konten yang harus bisa diperbarui tanpa merilis ulang
/// aplikasi — dan, untuk materi keanggotaan koperasi, konten yang **tidak
/// boleh ditulis pengembang**: syarat, kewajiban, dan mekanisme simpanan
/// mengikuti AD/ART koperasi dan hanya boleh diisi pengurus.
model ContentPage {
  id    String @id @default(uuid())
  /// Pengenal stabil yang dirujuk aplikasi, mis. `belanja-lokal`.
  slug  String @unique
  title String

  subtitle String?

  /// Bagian isi terurut: [{ heading, body }]. Bentuk sederhana ini cukup
  /// untuk artikel informasi dan tidak menuntut editor kaya.
  sections Json @default("[]")

  /// Catatan kaki, mis. dasar aturan atau kontak resmi.
  footnote String?

  /// Halaman yang belum terbit tetap bisa disiapkan tanpa terlihat pengguna.
  isPublished Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isPublished])
}

/// Banner promosi beranda, dikelola admin.
///
/// Sebelumnya daftar banner ditulis tetap di dalam widget Flutter, sehingga
/// mengganti promo berarti merilis ulang aplikasi.
model Banner {
  id          String  @id @default(uuid())
  badge       String?
  title       String
  highlight   String?
  description String?
  ctaLabel    String?

  /// Rute dalam aplikasi yang dibuka saat banner ditekan, mis. `/products`.
  ctaRoute String?
  imageUrl String?

  isActive  Boolean @default(true)
  sortOrder Int     @default(0)

  /// Jendela tayang. Null berarti tanpa batas.
  startsAt DateTime?
  endsAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, sortOrder])
}

model Review {
  id            String       @id @default(uuid())
  productId     String?
  product       Product?     @relation(fields: [productId], references: [id])
  umkmProductId String?
  umkmProduct   UMKMProduct? @relation(fields: [umkmProductId], references: [id])

  /// Ulasan untuk Kopdes sebagai tempat, bukan untuk produknya.
  koperasiId String?
  koperasi   Koperasi? @relation(fields: [koperasiId], references: [id], onDelete: Cascade)

  /// Ulasan untuk Mitra UMKM sebagai usaha.
  umkmId String?
  umkm   UMKM?   @relation(fields: [umkmId], references: [id], onDelete: Cascade)

  userId  String
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating  Int
  comment String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Satu pengguna satu ulasan per sasaran. Postgres memperbolehkan banyak
  /// NULL pada unique index, jadi keempat batasan ini tidak saling mengunci.
  @@unique([userId, koperasiId])
  @@unique([userId, umkmId])
  @@unique([userId, productId])
  @@unique([userId, umkmProductId])
  @@index([koperasiId])
  @@index([umkmId])
  @@index([productId])
  @@index([umkmProductId])
}

model CommunitySuggestion {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productName String
  category    String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  supporters CommunitySuggestionSupport[]
}

model CommunitySuggestionSupport {
  id           String              @id @default(uuid())
  suggestionId String
  suggestion   CommunitySuggestion @relation(fields: [suggestionId], references: [id], onDelete: Cascade)
  userId       String
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@unique([suggestionId, userId])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Mencatat setiap pergerakan stok, baik barang Kopdes (productId) maupun
// barang mitra UMKM (umkmProductId). Tepat satu dari keduanya terisi.
model InventoryTransaction {
  id            String                   @id @default(uuid())
  productId     String?
  product       Product?                 @relation(fields: [productId], references: [id], onDelete: Cascade)
  umkmProductId String?
  umkmProduct   UMKMProduct?             @relation(fields: [umkmProductId], references: [id], onDelete: Cascade)
  type          InventoryTransactionType
  quantity      Int
  // Stok sesudah transaksi ini — supaya riwayat bisa dibaca tanpa menghitung ulang.
  stockAfter    Int?
  reason        String?
  // Siapa yang mencatat. Null untuk pergerakan otomatis dari checkout.
  userId        String?
  user          User?                    @relation(fields: [userId], references: [id])

  /// Nomor struk dari sistem luar, mis. kasir POS. Null untuk pergerakan
  /// yang lahir di aplikasi ini sendiri.
  ///
  /// Unik supaya satu struk tidak pernah memotong stok dua kali. Kasir di
  /// desa berjalan di atas jaringan yang putus-nyambung dan akan mengirim
  /// ulang permintaan yang jawabannya tidak pernah sampai — tanpa kunci ini,
  /// satu penjualan tercatat berkali-kali dan stok sistem menjauh dari rak.
  externalRef String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId, createdAt])
  @@index([umkmProductId, createdAt])
  /// Umpan pemantauan menarik pergerakan terbaru lintas produk.
  @@index([createdAt])
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  details   String?
  ipAddress String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Percakapan 1-1 (mis. Admin Kopdes ↔ UMKM / Customer).
// user1Id selalu diurutkan lebih kecil dari user2Id agar unik & idempoten.
model Conversation {
  id            String   @id @default(uuid())
  user1Id       String
  user1         User     @relation("ConvUser1", fields: [user1Id], references: [id], onDelete: Cascade)
  user2Id       String
  user2         User     @relation("ConvUser2", fields: [user2Id], references: [id], onDelete: Cascade)
  lastMessageAt DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  messages ChatMessage[]

  @@unique([user1Id, user2Id])
}

model ChatMessage {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
  content        String
  readAt         DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([conversationId])
}

/// Pengajuan bergabung dari pengurus koperasi desa.
///
/// Formulirnya publik — koperasi yang belum punya akun tentu belum bisa
/// login. Yang dikumpulkan hanya cukup untuk memutuskan dan menghubungi:
/// identitas koperasi, letaknya, dan satu orang pengurus yang nantinya
/// menjadi Admin Kopdes.
///
/// Tidak ada kolom kata sandi di sini. Kata sandi dibuat saat pengajuan
/// disetujui, ditampilkan satu kali kepada Super Admin untuk diteruskan,
/// lalu hanya tersimpan sebagai hash di tabel User.
/// Keanggotaan warga pada satu Kopdes.
///
/// Sengaja TIDAK menyimpan NIK. Untuk koperasi desa, nama, nomor telepon,
/// dan alamat sudah cukup bagi pengurus yang mengenal warganya; menyimpan
/// nomor identitas nasional menambah kewajiban perlindungan data yang tidak
/// sebanding dengan manfaatnya di sini.
/// Dompet saldo milik seorang pengguna.
///
/// `balance` adalah **cache**, bukan sumber kebenaran: nilainya selalu sama
/// dengan jumlah seluruh `WalletEntry` dan hanya boleh diubah di dalam
/// transaksi yang sekaligus menulis entrinya. Menyimpan saldo sebagai kolom
/// yang ditambah-kurangi sendiri adalah cara paling umum uang menghilang —
/// satu kegagalan di tengah dan tidak ada jejak untuk merekonstruksinya.
model Wallet {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Decimal, bukan Float: rupiah tidak boleh melewati floating point.
  balance Decimal @default(0) @db.Decimal(14, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  entries WalletEntry[]
  topUps  WalletTopUp[]
}

/// Satu baris buku besar. Tidak pernah diubah maupun dihapus setelah dibuat —
/// koreksi dilakukan dengan menambah entri lawan, bukan menimpa yang lama.
model WalletEntry {
  id       String @id @default(uuid())
  walletId String
  wallet   Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  /// Bertanda: positif menambah saldo, negatif mengurangi.
  amount Decimal @db.Decimal(14, 2)

  /// Saldo sesudah entri ini. Disimpan supaya selisih pembukuan bisa
  /// ditelusuri ke baris tepatnya, bukan dihitung ulang dari nol.
  balanceAfter Decimal @db.Decimal(14, 2)

  type        WalletEntryType
  description String?

  /// Asal-usul entri: `topup`, `order`, `manual`. Dipakai untuk menautkan
  /// kembali ke sumbernya saat rekonsiliasi.
  referenceType String?
  referenceId   String?

  /// Kunci anti-ganda. Webhook Midtrans bisa datang lebih dari sekali untuk
  /// transaksi yang sama; tanpa kunci ini saldo bertambah dua kali.
  idempotencyKey String? @unique

  createdAt DateTime @default(now())

  @@index([walletId, createdAt])
}

/// Pengisian saldo lewat Midtrans.
///
/// Terpisah dari `Payment`, yang selalu terikat sebuah pesanan. Isi ulang
/// tidak punya pesanan, dan memaksakan `orderId` nullable di sana akan
/// melemahkan jaminan jalur checkout yang sudah jalan.
model WalletTopUp {
  id       String @id @default(uuid())
  walletId String
  wallet   Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  amount Decimal     @db.Decimal(14, 2)
  status TopUpStatus @default(PENDING)

  /// `TOPUP-{id}-{unix}` — dipakai Midtrans, unik, dan bisa ditelusuri balik.
  midtransOrderId   String        @unique
  paymentMethod     PaymentMethod
  transactionId     String?
  transactionStatus String?
  fraudStatus       String?

  /// Sesi Snap untuk melanjutkan isi ulang dari web atau aplikasi.
  snapToken       String? @unique
  snapRedirectUrl String?

  /// Jawaban mentah Midtrans: nomor VA, QR, atau tautan pembayaran.
  actions Json?

  expiresAt DateTime?
  paidAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([walletId, createdAt])
  @@index([status])
}

model KopdesMembership {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  kopdesId String
  kopdes   Koperasi @relation(fields: [kopdesId], references: [id], onDelete: Cascade)

  /// Data pendaftaran. Disalin, bukan dirujuk dari User: nama dan alamat
  /// akun bisa berubah kapan saja, sedangkan yang diverifikasi pengurus
  /// adalah data saat pengajuan.
  fullName String
  phone    String
  address  String

  /// Catatan bebas dari pemohon, mis. dusun atau RT/RW.
  note String?

  status MembershipStatus @default(PENDING)

  /// Alasan penolakan, atau catatan pengurus saat menyetujui.
  reviewNote   String?
  reviewedAt   DateTime?
  reviewedById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Satu warga satu keanggotaan per koperasi. Tanpa ini tombol "Daftar"
  /// yang ditekan dua kali membuat dua pengajuan yang harus ditolak manual.
  @@unique([userId, kopdesId])
  @@index([kopdesId, status])
}

model KopdesApplication {
  id String @id @default(uuid())

  // ── Koperasi yang diajukan ──
  kopdesName  String
  description String?
  address     String
  village     String
  district    String
  city        String
  province    String
  postalCode  String?

  /// Opsional saat mengajukan: pengurus desa sering tidak tahu koordinatnya.
  /// Super Admin melengkapi saat menyetujui, dan tanpa itu koperasinya tidak
  /// akan muncul di pencarian terdekat.
  latitude  Float?
  longitude Float?

  // ── Pengurus yang akan menjadi Admin Kopdes ──
  contactName  String
  contactEmail String
  contactPhone String

  /// Catatan bebas dari pemohon.
  notes String?

  status     KopdesApplicationStatus @default(PENDING)
  /// Alasan penolakan, atau catatan Super Admin saat menyetujui.
  reviewNote String?
  reviewedAt DateTime?
  reviewedBy String?

  /// Terisi setelah disetujui — koperasi yang lahir dari pengajuan ini.
  kopdesId String?   @unique
  kopdes   Koperasi? @relation(fields: [kopdesId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([contactEmail])
}

/// Status permintaan pencairan saldo penjual.
enum PayoutStatus {
  /// Diajukan penjual, menunggu pengurus Kopdes mentransfer.
  REQUESTED
  /// Sudah ditransfer pengurus Kopdes.
  PAID
  /// Ditolak; nominalnya kembali ke saldo tersedia.
  REJECTED
}

/// Rekening tujuan pencairan milik mitra UMKM. Satu per toko.
model UMKMBankAccount {
  id            String   @id @default(uuid())
  umkmId        String   @unique
  umkm          UMKM     @relation(fields: [umkmId], references: [id], onDelete: Cascade)
  bankName      String
  accountNumber String
  accountHolder String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

/// Permintaan pencairan saldo penjual.
///
/// Saldo penjual TIDAK disimpan sebagai angka: ia dihitung dari pesanan yang
/// selesai dikurangi fee Kopdes dan pencairan yang diajukan/dibayar. Baris
/// ini adalah satu-satunya "pengeluaran" dari saldo itu.
model UMKMPayout {
  id     String       @id @default(uuid())
  umkmId String
  umkm   UMKM         @relation(fields: [umkmId], references: [id], onDelete: Cascade)
  amount Decimal      @db.Decimal(14, 2)
  status PayoutStatus @default(REQUESTED)

  /// Rekening saat diajukan, dibekukan: mengganti rekening sesudahnya tidak
  /// boleh mengalihkan transfer yang sedang diproses.
  bankName      String
  accountNumber String
  accountHolder String

  requestedAt     DateTime  @default(now())
  processedAt     DateTime?
  processedById   String?
  /// Nomor referensi transfer dari bank, diisi pengurus saat membayar.
  transferRef     String?
  rejectionReason String?

  @@index([umkmId, status])
  @@index([status, requestedAt])
}
